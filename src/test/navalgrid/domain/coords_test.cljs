    (is (= 1.11125 (sut/parse-dms "001°06'40.5\"")))
    (is (= 1.11125 (sut/parse-dms "+001°06'40.5\"")))
    (is (= -1.11125 (sut/parse-dms "-001°06'40.5\"")))
    (is (= 1.11125 (sut/parse-dms "001 06 40.5")))
    (is (= 1.11125 (sut/parse-dms "+001 06 40.5")))
    (is (= -1.11125 (sut/parse-dms "-001 06 40.5")))
    (is (= 1.11125 (sut/parse-dms "001d06m40.5s")))
    (is (= 1.11125 (sut/parse-dms "+001d06m40.5s")))
