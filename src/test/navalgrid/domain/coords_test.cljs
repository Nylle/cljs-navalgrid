    (is (= 1.11125 (sut/parse-dms "001°06'40.5\" O")))
    (is (= 1.11125 (sut/parse-dms "001°06'40.5\" E")))
    (is (= -1.11125 (sut/parse-dms "001°06'40.5\" S")))
    (is (= -1.11125 (sut/parse-dms "001°06'40.5\" W")))
    (is (= 1.11125 (sut/parse-dms "001°06'40.5 N")))
    (is (= 1.11125 (sut/parse-dms "001°06'40.5 O")))
    (is (= 1.11125 (sut/parse-dms "001°06'40.5 E")))
    (is (= -1.11125 (sut/parse-dms "001°06'40.5 S")))
    (is (= -1.11125 (sut/parse-dms "001°06'40.5 W")))
    (is (= 1.11125 (sut/parse-dms "001°06'40.5N")))
    (is (= 1.11125 (sut/parse-dms "001°06'40.5O")))
    (is (= 1.11125 (sut/parse-dms "001°06'40.5E")))
    (is (= -1.11125 (sut/parse-dms "001°06'40.5S")))
