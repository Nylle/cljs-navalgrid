(ns navalgrid.domain.coords-test
  (:require [clojure.test :refer [deftest is testing]])
  (:require [navalgrid.domain.coords :as sut]))

(deftest sign->hem-test
  (is (= "E" (sut/sign->hem 1 false)))
  (is (= "N" (sut/sign->hem 1 true)))
  (is (= "W" (sut/sign->hem -1 false)))
  (is (= "S" (sut/sign->hem -1 true))))

(deftest hem->sign-test
  (is (= 1 (sut/hem->sign nil)))
  (is (= 1 (sut/hem->sign "")))
  (is (= 1 (sut/hem->sign "+")))
  (is (= -1 (sut/hem->sign "-")))
  (is (= 1 (sut/hem->sign "e")))
  (is (= 1 (sut/hem->sign " e ")))
  (is (= 1 (sut/hem->sign "E")))
  (is (= 1 (sut/hem->sign " E ")))
  (is (= 1 (sut/hem->sign "n")))
  (is (= 1 (sut/hem->sign " n ")))
  (is (= 1 (sut/hem->sign "N")))
  (is (= 1 (sut/hem->sign " N ")))
  (is (= -1 (sut/hem->sign "w")))
  (is (= -1 (sut/hem->sign " w ")))
  (is (= -1 (sut/hem->sign "W")))
  (is (= -1 (sut/hem->sign " W ")))
  (is (= -1 (sut/hem->sign "s")))
  (is (= -1 (sut/hem->sign " s ")))
  (is (= -1 (sut/hem->sign "S")))
  (is (= -1 (sut/hem->sign " S "))))

(deftest format-coords-test
  (is (= "49°39'00\"N" (sut/format-coords 49.65 :dms true)))
  (is (= "001°09'00\"W" (sut/format-coords -1.15 :dms false))))

(deftest coords->str-test
  (testing "signed decimal"
    (is (= nil (sut/coords->str nil :deg)))
    (is (= "1, 1" (sut/coords->str [1 1] :deg)))
    (is (= "-1, 1" (sut/coords->str [-1 1] :deg)))
    (is (= "1, -1" (sut/coords->str [1 -1] :deg)))
    (is (= "-1, -1" (sut/coords->str [-1 -1] :deg))))
  (testing "DD"
    (is (= nil (sut/coords->str nil :dd)))
    (is (= "01.100°N, 001.100°E" (sut/coords->str [1.1 1.1] :dd)))
    (is (= "01.100°S, 001.100°E" (sut/coords->str [-1.1 1.1] :dd)))
    (is (= "01.100°N, 001.100°W" (sut/coords->str [1.1 -1.1] :dd)))
    (is (= "01.100°S, 001.100°W" (sut/coords->str [-1.1 -1.1] :dd))))
  (testing "DMM"
    (is (= nil (sut/coords->str nil :dmm)))
    (is (= "01°00.00'N, 001°00.00'E" (sut/coords->str [1 1] :dmm)))
    (is (= "01°00.00'S, 001°00.00'E" (sut/coords->str [-1 1] :dmm)))
    (is (= "01°00.00'N, 001°00.00'W" (sut/coords->str [1 -1] :dmm)))
    (is (= "01°00.00'S, 001°00.00'W" (sut/coords->str [-1 -1] :dmm))))
  (testing "DMS"
    (is (= nil (sut/coords->str nil :dms)))
    (is (= "01°00'00\"N, 001°00'00\"E" (sut/coords->str [1 1] :dms)))
    (is (= "01°00'00\"S, 001°00'00\"E" (sut/coords->str [-1 1] :dms)))
    (is (= "01°00'00\"N, 001°00'00\"W" (sut/coords->str [1 -1] :dms)))
    (is (= "01°00'00\"S, 001°00'00\"W" (sut/coords->str [-1 -1] :dms))))
  (testing "Jerry's format"
    (is (= nil (sut/coords->str nil :jerry)))
    (is (= "01 00N, 001 00E" (sut/coords->str [1 1] :jerry)))
    (is (= "01 00S, 001 00E" (sut/coords->str [-1 1] :jerry)))
    (is (= "01 00N, 001 00W" (sut/coords->str [1 -1] :jerry)))
    (is (= "01 00S, 001 00W" (sut/coords->str [-1 -1] :jerry)))))

(deftest parse-dd-test
  (testing "signed +/-"
    (is (= 1.0001 (sut/parse-dd "001.0001°")))
    (is (= 1.0001 (sut/parse-dd "+001.0001°")))
    (is (= -1.0001 (sut/parse-dd "-001.0001°")))
    (is (= 1.0001 (sut/parse-dd "001.0001")))
    (is (= 1.0001 (sut/parse-dd "+001.0001")))
    (is (= -1.0001 (sut/parse-dd "-001.0001"))))
  (testing "hemisphere NESW"
    (is (= -1.0001 (sut/parse-dd "001.0001° S")))
    (is (= -1.0001 (sut/parse-dd "001.0001° W")))
    (is (= 1.0001 (sut/parse-dd "001.0001° N")))
    (is (= 1.0001 (sut/parse-dd "001.0001° O")))
    (is (= 1.0001 (sut/parse-dd "001.0001° E")))
    (is (= -1.0001 (sut/parse-dd "001.0001°S")))
    (is (= -1.0001 (sut/parse-dd "001.0001°W")))
    (is (= 1.0001 (sut/parse-dd "001.0001°N")))
    (is (= 1.0001 (sut/parse-dd "001.0001°O")))
    (is (= 1.0001 (sut/parse-dd "001.0001°E")))
    (is (= -1.0001 (sut/parse-dd "001.0001 S")))
    (is (= -1.0001 (sut/parse-dd "001.0001 W")))
    (is (= 1.0001 (sut/parse-dd "001.0001 N")))
    (is (= 1.0001 (sut/parse-dd "001.0001 O")))
    (is (= 1.0001 (sut/parse-dd "001.0001 E")))
    (is (= -1.0001 (sut/parse-dd "001.0001S")))
    (is (= -1.0001 (sut/parse-dd "001.0001W")))
    (is (= 1.0001 (sut/parse-dd "001.0001N")))
    (is (= 1.0001 (sut/parse-dd "001.0001O")))
    (is (= 1.0001 (sut/parse-dd "001.0001E")))))

(deftest parse-dmm-test
  (testing "signed +/-"
    (is (= 1.11 (sut/parse-dmm "001°06.600'")))
    (is (= 1.11 (sut/parse-dmm "+001°06.600'")))
    (is (= -1.11 (sut/parse-dmm "-001°06.600'")))
    (is (= 1.11 (sut/parse-dmm "001°06.600")))
    (is (= 1.11 (sut/parse-dmm "+001°06.600")))
    (is (= -1.11 (sut/parse-dmm "-001°06.600")))
    (is (= 1.11 (sut/parse-dmm "001 06.600")))
    (is (= 1.11 (sut/parse-dmm "+001 06.600")))
    (is (= -1.11 (sut/parse-dmm "-001 06.600")))
    (is (= 1.11 (sut/parse-dmm "001d06.600m")))
    (is (= 1.11 (sut/parse-dmm "+001d06.600m")))
    (is (= -1.11 (sut/parse-dmm "-001d06.600m"))))
  (testing "hemisphere NESW"
    (is (= 1.11 (sut/parse-dmm "001°06.600' N")))
    (is (= 1.11 (sut/parse-dmm "001°06.600' O")))
    (is (= 1.11 (sut/parse-dmm "001°06.600' E")))
    (is (= -1.11 (sut/parse-dmm "001°06.600' S")))
    (is (= -1.11 (sut/parse-dmm "001°06.600' W")))
    (is (= 1.11 (sut/parse-dmm "001 06.600 N")))
    (is (= 1.11 (sut/parse-dmm "001 06.600 O")))
    (is (= 1.11 (sut/parse-dmm "001 06.600 E")))
    (is (= -1.11 (sut/parse-dmm "001 06.600 S")))
    (is (= -1.11 (sut/parse-dmm "001 06.600 W")))
    (is (= 1.11 (sut/parse-dmm "001 06.600N")))
    (is (= 1.11 (sut/parse-dmm "001 06.600O")))
    (is (= 1.11 (sut/parse-dmm "001 06.600E")))
    (is (= -1.11 (sut/parse-dmm "001 06.600S")))
    (is (= -1.11 (sut/parse-dmm "001 06.600W")))
    (is (= 1.11 (sut/parse-dmm "001d06.600m N")))
    (is (= 1.11 (sut/parse-dmm "001d06.600m O")))
    (is (= 1.11 (sut/parse-dmm "001d06.600m E")))
    (is (= -1.11 (sut/parse-dmm "001d06.600m S")))
    (is (= -1.11 (sut/parse-dmm "001d06.600m W"))))
  (testing "Jerry's format"
    (is (= -1.1 (sut/parse-dmm "01 06S")))))

